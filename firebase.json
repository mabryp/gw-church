{
  "hosting": [
    {
      "target": "prod",
      "public": "site",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/home",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/social_media",
          "destination": "/connect",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=300"
            }
          ]
        }
      ]
    },
    {
      "target": "preprod",
      "public": "site",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/home",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/social_media",
          "destination": "/connect",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=300"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
